# Frontend
ALLOWED_ORIGIN=https://health.384571259.xyz

# Login
APP_USERNAME=your-login-name
APP_PASSWORD_SALT=replace-with-random-salt
APP_PASSWORD_SHA256=replace-with-sha256-of-salt-colon-password
APP_JWT_SECRET=replace-with-long-random-secret
APP_TOKEN_TTL_SECONDS=2592000

# Sync storage: use a private OSS bucket for the JSON state file
OSS_REGION=oss-cn-hongkong
OSS_BUCKET=your-private-sync-bucket
OSS_ACCESS_KEY_ID=replace-with-ram-access-key
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
OSS_STATE_PREFIX=metabolic-tracker

# Food photo recognition
# Option A: OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: chat / responses / auto
OPENAI_API_STYLE=chat

# Option B: Alibaba Cloud Model Studio / DashScope compatible mode
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_WORKSPACE_ID=llm-...
# DASHSCOPE_REGION=cn-beijing
